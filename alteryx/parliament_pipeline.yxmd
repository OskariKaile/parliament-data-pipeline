        <Node ToolID="21">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="150" y="400" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="ToNumber([ID])" field="BUSINESS_ID" size="8" type="Int64" />
                <FormulaField expression="[BusinessShortNumber]" field="SHORT_NUMBER" size="20" type="V_WString" />
                <FormulaField expression="[BusinessTypeAbbreviation]" field="BUSINESS_TYPE" size="20" type="V_WString" />
                <FormulaField expression="[BusinessTypeName]" field="BUSINESS_TYPE_NAME" size="200" type="V_WString" />
                <FormulaField expression="Trim([Title])" field="TITLE_DE" size="1000" type="V_WString" />
                <FormulaField expression="IIF(!IsEmpty([SubmittedText]), [SubmittedText], IIF(!IsEmpty([InitialSituation]), [InitialSituation], [Description]))" field="BODY_RAW" size="1073741823" type="V_WString" />
                <FormulaField expression="Left(Trim(REGEX_Replace(Replace(Replace(Replace(Replace(REGEX_Replace([BODY_RAW], '&lt;[^&gt;]+&gt;', ' '), '&amp;nbsp;', ' '), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;'), '\s+', ' ')), 16000)" field="BODY_DE" size="16000" type="V_WString" />
                <FormulaField expression="Left(Trim(REGEX_Replace(Replace(Replace(Replace(Replace(REGEX_Replace([ReasonText], '&lt;[^&gt;]+&gt;', ' '), '&amp;nbsp;', ' '), '&amp;lt;', '&lt;'), '&amp;gt;', '&gt;'), '&amp;amp;', '&amp;'), '\s+', ' ')), 16000)" field="REASON_DE" size="16000" type="V_WString" />
                <FormulaField expression="[BusinessStatusText]" field="STATUS" size="200" type="V_WString" />
                <FormulaField expression="[ResponsibleDepartmentAbbreviation]" field="DEPARTMENT" size="20" type="V_WString" />
                <FormulaField expression="[SubmissionCouncilAbbreviation]" field="COUNCIL" size="10" type="V_WString" />
                <FormulaField expression="[Tags]" field="TAG_IDS" size="200" type="V_WString" />
                <FormulaField expression="[TagNames]" field="TAG_NAMES" size="1000" type="V_WString" />
                <FormulaField expression="IIF(IsEmpty([TagNames]), 0, REGEX_CountMatches([TagNames], '\|') + 1)" field="TAG_COUNT" size="2" type="Int16" />
                <FormulaField expression="Length([BODY_DE])" field="BODY_CHARS" size="4" type="Int32" />
                <FormulaField expression="IIF(IsEmpty([SubmissionDate]), Null(), DateTimeFormat(DateTimeAdd('1970-01-01 00:00:00', FLOOR(ToNumber(REGEX_Replace([SubmissionDate], '[^0-9]', '')) / 1000), 'seconds'), '%Y-%m-%d'))" field="SUBMITTED_ON" size="10" type="Date" />
                <FormulaField expression="IIF(IsEmpty([Modified]), Null(), DateTimeFormat(DateTimeAdd('1970-01-01 00:00:00', FLOOR(ToNumber(REGEX_Replace([Modified], '[^0-9]', '')) / 1000), 'seconds'), '%Y-%m-%d %H:%M:%S'))" field="MODIFIED_AT" size="19" type="DateTime" />
                <FormulaField expression="'https://www.parlament.ch/de/ratsbetrieb/suche-curia-vista/geschaeft?AffairId=' + [ID]" field="SOURCE_URL" size="300" type="V_WString" />
                <FormulaField expression="DateTimeFormat(DateTimeStart(), '%Y%m%d%H%M%S')" field="RUN_ID" size="20" type="V_String" />
                <FormulaField expression="DateTimeStart()" field="LOADED_AT" size="19" type="DateTime" />
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>Types, HTML -&gt; text, epoch -&gt; date</AnnotationText>
              <DefaultAnnotationText />
              <Left value="False" />
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
        </Node>
