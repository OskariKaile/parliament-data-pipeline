        <Node ToolID="20">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Filter.Filter">
            <Position x="60" y="400" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <Expression>[ENTITY] = 'Business'</Expression>
              <Mode>Custom</Mode>
            </Configuration>
            <Annotation DisplayMode="0">
