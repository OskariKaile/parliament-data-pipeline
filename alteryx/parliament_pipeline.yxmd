<?xml version="1.0"?>
<AlteryxDocument yxmdVer="2024.1">
  <Nodes>
    <Node ToolID="1">
      <GuiSettings Plugin="AlteryxGuiToolkit.TextBox.TextBox">
        <Position x="30" y="10" width="1380" height="62" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Text>Swiss Parliament pipeline (Alteryx -&gt; Snowflake)
Source: Curia Vista OData API (ws.parlament.ch), business items, authors and members since [User.SinceDate] (Workflow Configuration &gt; Constants).
Adding a new API entity = one more row in the config Text Input (tool 1 in container 1).
Snowflake: ODBC DSN 'snowflake_parliament'. Each Output writes a RAW landing table, then its Post-SQL calls the MERGE procedure (CORE). Cortex AI enrichment is a Snowflake task on the CORE stream.</Text>
          <Font name="Segoe UI" size="9" style="0" />
          <TextColor name="Black" />
          <FillColor r="255" g="255" b="240" />
          <Shape shape="0" />
          <Justification Justification="0" />
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText />
          <Left value="False" />
        </Annotation>
      </Properties>
    </Node>
    <Node ToolID="2">
      <GuiSettings Plugin="AlteryxGuiToolkit.ToolContainer.ToolContainer">
        <Position x="30" y="90" width="1380" height="210" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <Caption>1  Extract: config-driven OData API ingestion (count -&gt; pages -&gt; JSON -&gt; records)</Caption>
          <Style TextColor="#314c4a" FillColor="#e8f1f2" BorderColor="#314c4a" Transparency="25" Margin="25" />
          <Disabled value="False" />
          <Folded value="False" />
        </Configuration>
        <Annotation DisplayMode="0">
          <Name />
          <DefaultAnnotationText />
          <Left value="False" />
        </Annotation>
      </Properties>
      <ChildNodes>
        <Node ToolID="3">
          <GuiSettings Plugin="AlteryxBasePluginsGui.TextInput.TextInput">
            <Position x="60" y="170" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <NumRows value="3" />
              <Fields>
                <Field name="ENTITY" />
                <Field name="FILTER" />
                <Field name="FIELDS" />
                <Field name="BASE_URL" />
                <Field name="PAGE_SIZE" />
              </Fields>
              <Data>
                <r><c>Business</c><c>Language eq 'DE' and SubmissionDate ge datetime'{SINCE}T00:00:00'</c><c>ID,BusinessShortNumber,BusinessTypeAbbreviation,BusinessTypeName,Title,Description,SubmittedText,ReasonText,InitialSituation,BusinessStatusText,ResponsibleDepartmentAbbreviation,SubmissionCouncilAbbreviation,Tags,TagNames,SubmissionDate,Modified</c><c>https://ws.parlament.ch/odata.svc</c><c>1000</c></r>
                <r><c>BusinessRole</c><c>Language eq 'DE' and Role eq 7 and BusinessSubmissionDate ge datetime'{SINCE}T00:00:00'</c><c>ID,BusinessNumber,MemberCouncilNumber,CommitteeNumber,CantonNumber,ParlGroupNumber,Role</c><c>https://ws.parlament.ch/odata.svc</c><c>1000</c></r>
                <r><c>MemberCouncil</c><c>Language eq 'DE' and (DateLeaving eq null or DateLeaving ge datetime'{SINCE}T00:00:00')</c><c>ID,FirstName,LastName,PartyAbbreviation,ParlGroupAbbreviation,CantonAbbreviation,CouncilAbbreviation,Active</c><c>https://ws.parlament.ch/odata.svc</c><c>1000</c></r>
              </Data>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>Config: one row per API entity</AnnotationText>
              <DefaultAnnotationText />
              <Left value="False" />
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxTextInput" />
        </Node>
        <Node ToolID="4">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="150" y="170" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="Replace(Replace(Replace([FILTER], '{SINCE}', [User.SinceDate]), ' ', '%20'), &quot;'&quot;, '%27')" field="FILTER_ENC" size="1000" type="V_WString" />
                <FormulaField expression="ToNumber([PAGE_SIZE])" field="PAGE_SIZE_N" size="4" type="Int32" />
                <FormulaField expression="[BASE_URL] + '/' + [ENTITY] + '/$count?$filter=' + [FILTER_ENC]" field="COUNT_URL" size="2000" type="V_WString" />
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>Build $count URL</AnnotationText>
              <DefaultAnnotationText />
              <Left value="False" />
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxBasePluginsEngine.dll" EngineDllEntryPoint="AlteryxFormula" />
        </Node>
        <Node ToolID="5">
          <GuiSettings Plugin="AlteryxConnectorGui.Download.Download">
            <Position x="240" y="170" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <URLField>COUNT_URL</URLField>
              <OutputMode>String</OutputMode>
              <CodePage>65001</CodePage>
              <EncodeURLs value="False" />
              <Headers>
                <NameValues>
                  <Item name="User-Agent" value="parliament-data-pipeline (portfolio project)" />
                </NameValues>
                <Fields orderChanged="False">
                  <Field name="*Unknown" selected="False" />
                </Fields>
              </Headers>
              <Payload>
                <HTTPAction>GET</HTTPAction>
                <QueryStringBodyMode>Compose</QueryStringBodyMode>
                <ComposeNameValues />
                <ComposeFields orderChanged="False">
                  <Field name="*Unknown" selected="False" />
                </ComposeFields>
              </Payload>
              <UserName />
              <Password />
              <numConnections>2</numConnections>
              <Timeout>600</Timeout>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>GET row count</AnnotationText>
              <DefaultAnnotationText />
              <Left value="False" />
            </Annotation>
          </Properties>
          <EngineSettings EngineDll="AlteryxConnectorEngine.dll" EngineDllEntryPoint="AlteryxDownload" />
        </Node>
        <Node ToolID="6">
          <GuiSettings Plugin="AlteryxBasePluginsGui.Formula.Formula">
            <Position x="330" y="170" />
          </GuiSettings>
          <Properties>
            <Configuration>
              <FormulaFields>
                <FormulaField expression="ToNumber(Trim([DownloadData]))" field="TOTAL" size="8" type="Int64" />
                <FormulaField expression="CEIL([TOTAL] / [PAGE_SIZE_N])" field="N_PAGES" size="4" type="Int32" />
              </FormulaFields>
            </Configuration>
            <Annotation DisplayMode="0">
              <Name />
              <AnnotationText>Pages needed</AnnotationText>
              <DefaultAnnotationText />
              <Left value="False" />
